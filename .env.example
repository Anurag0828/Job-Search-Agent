# ============================================================
# AI Job Search Agent — Environment Variables
# ============================================================
# INSTRUCTIONS:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in your actual values in .env
#   3. NEVER commit .env to git (it has your secrets)
# ============================================================

# --- LLM Configuration ---
# Which AI model to use? Options: "openai", "gemini", "claude"
LLM_PROVIDER=openai

# OpenAI (required if LLM_PROVIDER=openai)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o

# Google Gemini (required if LLM_PROVIDER=gemini)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-pro

# Anthropic Claude (required if LLM_PROVIDER=claude)
CLAUDE_API_KEY=your-claude-api-key-here
CLAUDE_MODEL=claude-sonnet-4-20250514

# --- Database ---
# SQLite is the default (no setup needed). Just a file on your disk.
# To switch to PostgreSQL later, change this to:
#   DATABASE_URL=postgresql://user:password@localhost:5432/jobsearch
DATABASE_URL=sqlite:///./data/jobsearch.db

# --- Email Configuration ---
# Gmail App Password: Go to Google Account → Security → 2-Step Verification → App Passwords
EMAIL_SENDER=your.email@gmail.com
EMAIL_PASSWORD=your-gmail-app-password
EMAIL_RECIPIENT=your.email@gmail.com
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587

# --- Browser Automation ---
# Port where Chrome's remote debugging is running
# Launch Chrome with: chrome.exe --remote-debugging-port=9222
CHROME_DEBUG_PORT=9222

# --- Job Search Preferences ---
# Comma-separated list of job titles to search for
SEARCH_QUERIES=Full Stack Developer,Backend Engineer,Python Developer

# Comma-separated list of preferred locations
SEARCH_LOCATIONS=Bangalore,Remote,Hyderabad

# --- Scheduling ---
# What time to run the daily search (24-hour format)
SCHEDULE_HOUR=8
SCHEDULE_MINUTE=0

# --- Matching & Ranking ---
# Minimum match score (0-100) to include in email. Jobs below this are discarded.
MIN_MATCH_SCORE=65

# How many top recommendations to include in the email
MAX_RECOMMENDATIONS=10

# --- Platform Toggles ---
# Enable/disable individual platforms (true/false)
ENABLE_LINKEDIN_JOBS=true
ENABLE_LINKEDIN_POSTS=true
ENABLE_NAUKRI=true
ENABLE_INDEED=true

# --- Logging ---
# Options: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
