# ============================================================
# AI Job Search Agent — Environment Variables Template
# ============================================================
# INSTRUCTIONS:
#   1. Copy this file: cp .env.example .env
#   2. Fill in your actual values in .env
#   3. NEVER commit .env or auth.json to git (they contain your secrets)
# ============================================================

# --- LLM Configuration ---
# Which AI model provider to use: "nvidia", "gemini", "openai", "claude"
LLM_PROVIDER=nvidia

# NVIDIA NIM (Default & Recommended)
# Get a free key with 1000 credits at https://build.nvidia.com
NVIDIA_API_KEY=your-nvidia-api-key-here
NVIDIA_MODEL=openai/gpt-oss-20b

# Vector Embeddings (ChromaDB RAG)
# Options: "nvidia" (nemotron-3-embed-1b) or "local" (sentence-transformers)
EMBEDDING_PROVIDER=nvidia
NVIDIA_EMBED_MODEL=nvidia/nemotron-3-embed-1b

# Google Gemini (Optional)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# OpenAI (Optional)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o

# Anthropic Claude (Optional)
CLAUDE_API_KEY=your-claude-api-key-here
CLAUDE_MODEL=claude-sonnet-4-20250514

# --- Database ---
DATABASE_URL=sqlite:///./data/jobsearch.db

# --- Email Notification Configuration ---
# Gmail App Password: https://myaccount.google.com/apppasswords
EMAIL_SENDER=your-sender-email@gmail.com
EMAIL_PASSWORD=your-16-char-gmail-app-password
EMAIL_RECIPIENT=your-destination-email@gmail.com
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587

# --- Browser Automation ---
CHROME_DEBUG_PORT=9222

# --- Job Search Preferences ---
SEARCH_QUERIES=Junior AI Engineer,AI Engineer
SEARCH_LOCATIONS=India

# --- Scheduling & Thresholds ---
SCHEDULE_HOUR=8
SCHEDULE_MINUTE=0
MIN_MATCH_SCORE=65
MAX_RECOMMENDATIONS=10

# --- Platform Toggles ---
ENABLE_LINKEDIN_JOBS=true
ENABLE_LINKEDIN_POSTS=false
ENABLE_NAUKRI=false
ENABLE_INDEED=false

# --- Logging ---
LOG_LEVEL=INFO
